PROJECT_NAME="EndoAI Vision"
VERSION="0.1.0"
DEBUG=True
API_V1_STR="/api"

# Database
DATABASE_URL="sqlite:///./endoai_vision.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://endoai:endoai_pass@localhost:5432/endoai_db"

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=50

# AI Model Configuration
DETECTOR_MODEL_PATH="./models/detector/yolov8_endo.pt"
CLASSIFIER_MODEL_PATH="./models/classifier/resnet50_endo.pt"
USE_DEMO_FALLBACK=True

# Confidence Thresholds
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.50

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
